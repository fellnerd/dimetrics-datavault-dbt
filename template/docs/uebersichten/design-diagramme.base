filters:
  and:
    - or:
        - file.inFolder("04-mandant-architektur/raw-vault")
        - file.inFolder("04-mandant-architektur/information-mart")
    - or:
        - file.hasTag("typ/er-diagramm")
        - file.ext == "canvas"
    - '!file.name.startsWith("00-")'
formulas:
  schicht: if(file.inFolder("04-mandant-architektur/raw-vault"), "Raw Vault", "Information Mart")
  format: if(file.ext == "canvas", "Canvas", if(file.name.contains("-d2"), "D2", if(file.name.contains("-dbml"), "DBML", "Mermaid")))
properties:
  file.name:
    displayName: Diagramm
  file.folder:
    displayName: Domäne
  formula.schicht:
    displayName: Schicht
  formula.format:
    displayName: Format
  file.mtime:
    displayName: Geändert
views:
  - type: table
    name: Nach Domäne
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - formula.schicht
      - formula.format
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Raw Vault
    filters:
      and:
        - file.inFolder("04-mandant-architektur/raw-vault")
    groupBy:
      property: formula.format
      direction: ASC
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: table
    name: Information Mart
    filters:
      and:
        - file.inFolder("04-mandant-architektur/information-mart")
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: cards
    name: Canvas-Diagramme
    filters:
      and:
        - file.ext == "canvas"
    order:
      - file.name
      - file.folder
      - file.mtime
