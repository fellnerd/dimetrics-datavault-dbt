filters:
  and:
    - "file.inFolder(\"04-mandant-architektur\")"
    - "file.ext == \"md\""
formulas:
  verlinkt_von: "file.backlinks.length"
  verweist_auf: "file.links.length"
properties:
  file.name:
    displayName: "Datei"
  note.title:
    displayName: "Titel"
  note.tags:
    displayName: "Tags"
  file.folder:
    displayName: "Ordner"
  file.mtime:
    displayName: "Geändert"
  formula.verlinkt_von:
    displayName: "Verlinkt von"
  formula.verweist_auf:
    displayName: "Verweist auf"
views:
  - type: "table"
    name: "Kapitel"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.path"
        direction: "ASC"
  - type: "table"
    name: "Nach Ordner"
    groupBy:
      property: "file.folder"
      direction: "ASC"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.name"
        direction: "ASC"
  - type: "table"
    name: "Nach Tag"
    groupBy:
      property: "note.tags"
      direction: "ASC"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.name"
        direction: "ASC"
  - type: "table"
    name: "Raw Vault"
    filters:
      and:
        - "file.inFolder(\"04-mandant-architektur/raw-vault\")"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.path"
        direction: "ASC"
  - type: "table"
    name: "Business Vault"
    filters:
      and:
        - "file.inFolder(\"04-mandant-architektur/business-vault\")"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.path"
        direction: "ASC"
  - type: "table"
    name: "Information Mart"
    filters:
      and:
        - "file.inFolder(\"04-mandant-architektur/information-mart\")"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.path"
        direction: "ASC"
  - type: "table"
    name: "Projektdokumentation"
    filters:
      and:
        - "file.inFolder(\"04-mandant-architektur/projektdokumentation\")"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.path"
        direction: "ASC"
  - type: "table"
    name: "Quellsysteme"
    filters:
      and:
        - "file.inFolder(\"04-mandant-architektur/quellsysteme\")"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.path"
        direction: "ASC"
  - type: "table"
    name: "Diagramme"
    filters:
      and:
        - "file.hasTag(\"typ/er-diagramm\")"
    groupBy:
      property: "file.folder"
      direction: "ASC"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.name"
        direction: "ASC"
  - type: "table"
    name: "Nachschlagen"
    order:
      - "file.name"
      - "note.title"
      - "note.tags"
      - "file.mtime"
    sort:
      - property: "file.name"
        direction: "ASC"
    filters:
      or:
        - "file.hasTag(\"typ/glossar\")"
        - "file.hasTag(\"typ/faq\")"
        - "file.hasTag(\"typ/troubleshooting\")"
        - "file.hasTag(\"typ/checkliste\")"
        - "file.hasTag(\"typ/nachschlagen\")"
        - "file.hasTag(\"typ/changelog\")"
  - type: "table"
    name: "Zuletzt geändert"
    order:
      - "file.name"
      - "note.title"
      - "file.folder"
      - "file.mtime"
    sort:
      - property: "file.mtime"
        direction: "DESC"
    limit: 25
  - type: "table"
    name: "Wenig verlinkt"
    filters:
      and:
        - "formula.verlinkt_von < 2"
        - "!file.hasTag(\"typ/inhaltsverzeichnis\")"
    order:
      - "file.name"
      - "note.title"
      - "formula.verlinkt_von"
      - "formula.verweist_auf"
    sort:
      - property: "formula.verlinkt_von"
        direction: "ASC"
